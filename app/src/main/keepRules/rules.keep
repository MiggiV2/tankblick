# R8 keep rules. AGP combines every file in src/main/keepRules and passes them to R8.
# See https://d.android.com/r/tools/r8/keep-rules

# --- kotlinx.serialization ---
# Generated serializers are only reachable through the companion object, so R8
# cannot see the link and would otherwise strip them.
-keepattributes *Annotation*, InnerClasses
-dontnote kotlinx.serialization.**

-if @kotlinx.serialization.Serializable class **
-keepclassmembers class <1> {
    static <1>$Companion Companion;
}
-if @kotlinx.serialization.Serializable class ** {
    static **$* *;
}
-keepclassmembers class <2>$<3> {
    kotlinx.serialization.KSerializer serializer(...);
}
-if @kotlinx.serialization.Serializable class **
-keepclassmembers class <1> {
    public static <1> INSTANCE;
    kotlinx.serialization.KSerializer serializer(...);
}

# --- Ktor / OkHttp ---
# Ktor picks its engine up through a ServiceLoader, so the implementation class
# is never referenced by name from our code.
-keep class io.ktor.client.engine.okhttp.OkHttpEngineContainer { *; }
-dontwarn io.ktor.**
-dontwarn org.slf4j.**
-dontwarn okhttp3.**
-dontwarn okio.**
-dontwarn org.conscrypt.**
-dontwarn org.bouncycastle.**
-dontwarn org.openjsse.**
