<!--
    Tankblick icon: a fuel gauge that reads as an eye.

    The upper arc is both the gauge scale and the eyelid, the needle is the
    direction of the glance, and the pivot is the pupil. design/logo.svg is the
    source of truth for this geometry.

    The motif stays inside the centre 66x66 of the 108x108 canvas, which is the
    safe zone every launcher mask keeps visible, and is optically centred: the
    lower lid carries less weight, so a bounding-box centre would sit high.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Eyelid / gauge scale -->
    <path
        android:pathData="M 23,62 A 31,31 0 0 1 85,62"
        android:strokeWidth="6"
        android:strokeColor="#97F0FF"
        android:strokeLineCap="round" />

    <!-- Lower lid, closing the almond shape -->
    <path
        android:pathData="M 23,62 A 42,42 0 0 0 85,62"
        android:strokeWidth="6"
        android:strokeColor="#97F0FF"
        android:strokeAlpha="0.75"
        android:strokeLineCap="round" />

    <!-- Scale ticks: empty on the left, full on the right -->
    <path
        android:pathData="M 30.4,48.6 L 33.3,52"
        android:strokeWidth="3.2"
        android:strokeColor="#97F0FF"
        android:strokeAlpha="0.85"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 54,39.5 L 54,44"
        android:strokeWidth="3.2"
        android:strokeColor="#97F0FF"
        android:strokeAlpha="0.85"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 77.6,48.6 L 74.7,52"
        android:strokeWidth="3.2"
        android:strokeColor="#97F0FF"
        android:strokeAlpha="0.85"
        android:strokeLineCap="round" />

    <!-- Needle: towards a full tank and a cheap price -->
    <path
        android:pathData="M 54,62 L 39,47"
        android:strokeWidth="6"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Pupil / pivot -->
    <path
        android:pathData="M 46.5,62 a 7.5,7.5 0 1,0 15,0 a 7.5,7.5 0 1,0 -15,0 Z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M 50.8,62 a 3.2,3.2 0 1,0 6.4,0 a 3.2,3.2 0 1,0 -6.4,0 Z"
        android:fillColor="#00363D" />
</vector>
