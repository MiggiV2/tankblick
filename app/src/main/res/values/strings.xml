    <string name="station_open">open</string>
    <string name="station_closed">closed</string>
    <string name="price_unavailable">no price</string>
    <string name="price_spoken">%1$s euros per litre</string>
    <string name="favorite_add">Add to favourites</string>
    <string name="favorite_remove">Remove from favourites</string>
    <string name="nearby_empty_title">No stations yet</string>
    <string name="nearby_empty_body">Start a search to see prices near you. Tankblick only fetches data when you ask it to — never in the background.</string>

