<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">
    <!--
        English is the default locale: a device set to a language the app does
        not speak falls back to values/, and F-Droid asks that this be English
        rather than the author's own language. German, the language of the
        users this app is aimed at, lives in values-de/.
    -->

    <!-- A proper noun, and a UUID pattern: neither is translated. -->
    <string name="app_name" translatable="false">Tankblick</string>

    <!-- Required by the CC BY 4.0 licence of the MTS-K price data. -->
    <string name="attribution_short">Price data: Tankerkönig / MTS-K, CC BY 4.0</string>

    <!-- Onboarding -->
    <string name="onboarding_title">Set up your API key</string>
    <string name="onboarding_why">Tankblick fetches fuel prices straight from Tankerkönig, which needs your own free API key. Shipping one inside the app would not work: it could be extracted from any APK and would be blocked in no time.</string>
    <string name="onboarding_steps">1. Register at onboarding.tankerkoenig.de — first name, last name and email address are required.\n2. Keys are reviewed by hand, which can take a few days.\n3. Enter the key here.</string>
    <string name="onboarding_open_registration">Request a key</string>
    <string name="onboarding_key_label">API key</string>
    <string name="onboarding_key_placeholder" translatable="false" tools:ignore="TypographyDashes">00000000-0000-0000-0000-000000000000</string>
    <string name="onboarding_key_hint">A key looks like a UUID.</string>
    <string name="onboarding_key_invalid">That does not look like a Tankerkönig key. A 36-character UUID is expected.</string>
    <string name="onboarding_save">Save key</string>
    <string name="onboarding_use_demo_key">Try it with the demo key first</string>
    <string name="onboarding_build_key_rejected">Tankerkönig no longer accepts the key that shipped with this version of the app. Please enter your own — or use the demo key in the meantime.</string>
    <string name="onboarding_privacy_note">The key stays on this device: encrypted in the Android Keystore, and excluded from cloud backup and device transfer.</string>

    <!-- Fuel types and sorting -->
    <string name="fuel_e5">Super E5</string>
    <string name="fuel_e10">Super E10</string>
    <string name="fuel_diesel">Diesel</string>
    <string name="sort_price">By price</string>
    <string name="sort_distance">By distance</string>

