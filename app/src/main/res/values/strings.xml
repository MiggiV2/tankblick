    <!-- Messages -->
    <string name="message_missing_api_key">Without an API key Tankblick cannot fetch prices.</string>
    <string name="message_needs_location_permission">A nearby search needs your approximate location. It leaves the device only as a coordinate pair in the request to Tankerkönig.</string>
    <string name="message_location_disabled">Location services are switched off.</string>
    <string name="message_location_unavailable">No position could be determined. Outdoors or near a window usually works better.</string>
    <string name="message_no_results">There is no station within the chosen radius.</string>
    <string name="message_offline">No connection. Showing the last prices that were saved.</string>
    <string name="message_invalid_key">The API key was rejected. Check it in the settings.</string>
    <plurals name="message_rate_limited">
        <item quantity="one">Tankerkönig allows one request per minute. %1$d second to go.</item>
        <item quantity="other">Tankerkönig allows one request per minute. %1$d seconds to go.</item>
    </plurals>
    <string name="message_server_error">Tankerkönig is not responding right now (error %1$d).</string>
    <string name="message_failed">The response was unusable.</string>
