        <item quantity="one">%1$d kilometre</item>
        <item quantity="other">%1$d kilometres</item>
    </plurals>
    <string name="settings_radius_hint">Tankerkönig allows at most 25 km. Takes effect on the next search.</string>
    <string name="settings_nav_app">Navigation app</string>
    <string name="settings_nav_app_ask">Ask every time</string>
    <string name="settings_nav_app_none">No installed app can handle navigation. Organic Maps and OsmAnd are both on F-Droid.</string>
    <string name="settings_api_key">API key</string>
    <string name="settings_api_key_none">No key stored</string>
    <string name="settings_api_key_demo">This is the demo key. It returns sample data, not real prices.</string>
    <string name="settings_api_key_replace">Replace key</string>
    <string name="settings_api_key_forget">Delete key</string>
    <string name="settings_api_key_build">Shipped with this version of the app. You can enter your own key, which then takes precedence.</string>
    <string name="settings_about">About Tankblick</string>
    <string name="settings_privacy_title">Privacy</string>
    <string name="settings_privacy_body">Tankblick talks to exactly one server: creativecommons.tankerkoenig.de. No account, no tracking, no analytics, no ads.\n\nYour location leaves the device only as a coordinate pair in a search you started yourself — never in the background. The API key is encrypted in the Android Keystore and excluded from backups. Favourites, settings and prices stay local; price history is deleted after 30 days.</string>
    <string name="settings_version">Version %1$s</string>
    <string name="settings_licence">Tankblick is licensed under the GPL-3.0-or-later.</string>
    <string name="settings_open_tankerkoenig">Tankerkönig</string>
    <string name="settings_open_licence">CC BY 4.0</string>
    <string name="action_cancel">Cancel</string>

    <!-- Freshness -->
    <string name="last_updated">As of %1$s</string>
    <string name="age_just_now">just now</string>
    <plurals name="age_minutes">
        <item quantity="one">%1$d minute ago</item>
        <item quantity="other">%1$d minutes ago</item>
    </plurals>
    <plurals name="age_hours">
        <item quantity="one">%1$d hour ago</item>
        <item quantity="other">%1$d hours ago</item>
