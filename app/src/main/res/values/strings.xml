    <string name="detail_unknown_station">No data available for this station.</string>
    <string name="detail_opening_hours">Opening hours</string>
    <string name="detail_opening_hours_loading">loading …</string>
    <string name="detail_opening_hours_unknown">No opening hours published.</string>
    <string name="detail_open_all_day">Open around the clock</string>
